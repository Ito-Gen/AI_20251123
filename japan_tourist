                image: "https://images.unsplash.com/photo-1571556745977-3c119fa5de3f?auto=format&fit=crop&w=1200&q=80",
                tags: ["castle", "history", "park"]
            },
            {
                id: 9,
                nameEn: "Itsukushima Shrine",
                nameJp: "厳島神社",
                area: "Chugoku",
                prefecture: "Hiroshima",
                seasons: ["Autumn", "Spring"],
                tagline: "海に浮かぶ朱の大鳥居",
                description: "潮の満ち引きで姿を変える神殿建築。海と山に抱かれた神域で、世界遺産にも登録されています。",
                highlight: "干潮時は鳥居の近くまで歩け、満潮時は船から参拝可能。",
                access: "JR宮島口駅からフェリーで約10分",
                mapLink: "https://www.google.com/maps/search/?api=1&query=Itsukushima+Shrine",
                image: "https://images.unsplash.com/photo-1480796927426-f609979314bd?auto=format&fit=crop&w=1200&q=80",
                tags: ["island", "shrine", "world heritage"]
            },
            {
                id: 10,
                nameEn: "Mount Fuji Panorama",
                nameJp: "富士山 展望",
                area: "Chubu",
                prefecture: "Yamanashi",
                seasons: ["Summer", "Winter"],
                tagline: "日本一の霊峰が描くシンメトリー",
                description: "富士五湖エリアから望む富士山は、雲海と朝焼けが織りなすドラマ。登山やトレッキング、温泉も充実。",
                highlight: "初夏のご来光登山は一生の思い出に。",
                access: "新宿から高速バスで河口湖まで約2時間",
                mapLink: "https://www.google.com/maps/search/?api=1&query=Mount+Fuji",
                image: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80",
                tags: ["mountain", "sunrise", "iconic"]
            },
            {
                id: 11,
                nameEn: "Shirakawa-go",
                nameJp: "白川郷",
                area: "Chubu",
                prefecture: "Gifu",
                seasons: ["Winter"],
                tagline: "合掌造りの灯りが雪国を照らす",
                description: "豪雪地帯で育まれた合掌造り集落。茅葺きの家々からこぼれる灯火が、幻想的な冬景色を演出します。",
                highlight: "冬季ライトアップは事前予約制で、特別な夜を体験できます。",
                access: "高山駅からバスで約50分",
                mapLink: "https://www.google.com/maps/search/?api=1&query=Shirakawa-go",
                image: "https://images.unsplash.com/photo-1518684079-3c830dcef090?auto=format&fit=crop&w=1200&q=80",
                tags: ["village", "snow", "world heritage"]
            },
            {
                id: 12,
                nameEn: "Otaru Canal",
                nameJp: "小樽運河",
                area: "Hokkaido",
                prefecture: "Hokkaido",
                seasons: ["Winter", "Spring"],
                tagline: "北の港町に灯るガス灯の光",
                description: "石造倉庫群と運河沿いの散策路がロマンを誘います。硝子工芸や海鮮グルメも堪能できます。",
                highlight: "雪の降る夜、灯りが水面に反射して幻想的な景色に。",
                access: "札幌からJRで約35分",
                mapLink: "https://www.google.com/maps/search/?api=1&query=Otaru+Canal",
                image: "https://images.unsplash.com/photo-1617957545427-21f922f0df65?auto=format&fit=crop&w=1200&q=80",
                tags: ["canal", "winter", "romantic"]
            }
        ];

        const filterState = {
            area: 'all',
            season: 'all',
            query: ''
        };

        const spotGrid = document.getElementById('spot-grid');
        const areaFilters = document.getElementById('area-filters');
        const seasonFilters = document.getElementById('season-filters');
        const searchInput = document.getElementById('search-input');
        const resultsCount = document.getElementById('results-count');
        const heroCount = document.getElementById('hero-count');

        const seasonOrder = ["Spring", "Summer", "Autumn", "Winter"];
        const seasonLabels = {
            Spring: "春 - Sakura",
            Summer: "夏 - Matsuri",
            Autumn: "秋 - Koyo",
            Winter: "冬 - Snow"
        };

        document.addEventListener('DOMContentLoaded', () => {
            renderAreaFilters();
            renderSeasonFilters();
            attachSearch();
            renderSpots();
            updateHeroCount();
        });

        areaFilters.addEventListener('click', (event) => {
            const button = event.target.closest('button');
            if (!button) return;
            filterState.area = button.dataset.area;
            renderAreaFilters();
            renderSpots();
        });

        seasonFilters.addEventListener('click', (event) => {
            const button = event.target.closest('button');
            if (!button) return;
            filterState.season = button.dataset.season;
            renderSeasonFilters();
            renderSpots();
        });

        function renderAreaFilters() {
            const uniqueAreas = Array.from(new Set(spots.map(spot => spot.area))).sort();
            const areaList = ['all', ...uniqueAreas];
            areaFilters.innerHTML = areaList.map(area => `
                <button class="pill ${filterState.area === area ? 'active' : ''}" data-area="${area}">
                    ${area === 'all' ? '全国' : area}
                </button>
            `).join('');
        }

        function renderSeasonFilters() {
            const usedSeasons = seasonOrder.filter(season =>
                spots.some(spot => spot.seasons.includes(season))
            );
            const seasonList = ['all', ...usedSeasons];
            seasonFilters.innerHTML = seasonList.map(season => `
                <button class="pill ${filterState.season === season ? 'active' : ''}" data-season="${season}">
                    ${season === 'all' ? 'すべて' : seasonLabels[season]}
                </button>
            `).join('');
        }

        function attachSearch() {
            searchInput.addEventListener('input', (event) => {
                filterState.query = event.target.value.trim().toLowerCase();
                renderSpots();
            });
        }

        function matchesFilters(spot) {
            const matchArea = filterState.area === 'all' || spot.area === filterState.area;
            const matchSeason = filterState.season === 'all' || spot.seasons.includes(filterState.season);
            const text = `${spot.nameEn} ${spot.nameJp} ${spot.description} ${spot.tags.join(' ')}`.toLowerCase();
            const matchQuery = !filterState.query || text.includes(filterState.query);
            return matchArea && matchSeason && matchQuery;
        }

        function renderSpots() {
            const filtered = spots.filter(matchesFilters);
            resultsCount.textContent = filtered.length;

            if (!filtered.length) {
                spotGrid.innerHTML = `<div class="empty-state">条件に合うスポットが見つかりませんでした。フィルターを調整してください。</div>`;
                return;
            }

            spotGrid.innerHTML = filtered.map(createCard).join('');
        }

        function createCard(spot) {
            return `
                <article class="card">
                    <div class="card-image" style="background-image: url('${spot.image}');">
                        <span class="area-badge">${spot.area} / ${spot.prefecture}</span>
                    </div>
                    <div class="card-body">
                        <p class="jp-label">${spot.tagline}</p>
                        <h2>${spot.nameEn}</h2>
                        <p class="jp-label">${spot.nameJp}</p>
                        <p>${spot.description}</p>
                        <div class="card-highlight">
                            <strong>✨ Highlight</strong>
                            <p>${spot.highlight}</p>
                        </div>
                        <div class="card-meta">
                            <span class="season-tag">${spot.seasons.join(' · ')}</span>
                            <span>🚉 ${spot.access}</span>
                        </div>
                        <div class="card-footer">
                            <a class="map-btn" href="${spot.mapLink}" target="_blank" rel="noopener">Google Maps</a>
                        </div>
                    </div>
                </article>
            `;
        }

        function updateHeroCount() {
            heroCount.textContent = spots.length;
        }
    </script>
</body>
</html>
